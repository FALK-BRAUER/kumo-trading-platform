# Copy to instances/<name>/instance.env and edit. Every value below is illustrative.

INSTANCE=my-instance

# ---- identity -------------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=kumo-my-instance
# PIN THIS ONCE AND NEVER CHANGE IT. It names the volumes that hold Postgres, the Nautilus durable
# cache and the settings. Changing it does not fail — docker creates empty volumes silently.
KUMO_VOLUME_PREFIX=kumo-my-instance

# ---- providers ------------------------------------------------------------------------------------
KUMO_DATA=alpaca
KUMO_EXEC=alpaca          # "ibkr" for an IBKR instance

# ---- ports ----------------------------------------------------------------------------------------
# Must be unique per instance on the same host, or two stacks cannot run together.
KUMO_API_PORT=8000
KUMO_UI_PORT=3000

# ---- engine ---------------------------------------------------------------------------------------
KUMO_ENGINE=live
KUMO_DURABLE_CACHE=true
KUMO_LOG_LEVEL=INFO

# ---- gates ----------------------------------------------------------------------------------------
# OFF by default and on purpose (CLAUDE.md: all new automation gates default False, opt-in only).
# ORDERS_ARMED decides whether orders leave the process at all.
KUMO_ORDERS_ARMED=false
KUMO_MOMENTUM_ENABLED=false

# ---- network policy -------------------------------------------------------------------------------
# `*` suits a paper stack on localhost/LAN/tailscale. Narrow it for anything else.
KUMO_CORS_ORIGINS=*
KUMO_BIND_HOST=0.0.0.0
