# Copy to deploy/.env.prod (gitignored) and fill in. Loaded by `make up-prod`. REAL MONEY.
# Use the LIVE account's DEDICATED SECONDARY USER (not your primary login) so the gateway does not get
# bumped when you open the IBKR phone app. See README "Live secondary user".
DATABENTO_API_KEY=db-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWS_USERID=your-live-secondary-user
TWS_PASSWORD=your-live-secondary-password
IBKR_ACCOUNT_ID=U<your-live-account-id>
