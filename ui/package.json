{
  "name": "kumo-cockpit-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Render-only Next.js cockpit — REST + WebSocket to the FastAPI/Nautilus bridge",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "gen:openapi": "cd ../backend && ./.venv/bin/python -m scripts.export_openapi ../ui/openapi.json",
    "gen:types": "openapi-typescript openapi.json -o src/lib/api/schema.ts",
    "gen:api": "npm run gen:openapi && npm run gen:types",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lightweight-charts": "^5.0.0",
    "lucide-react": "^0.468.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.5.3",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-grid-layout": "^1.3.6",
    "openapi-typescript": "^7.3.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
