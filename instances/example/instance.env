# example — the instance template. Copy this directory to instances/<name>/ and edit.
# Values here are NOT secrets: ports, project name, feature gates, bind host. Secrets are NAMED in
# secrets.manifest and resolved from the secret store at deploy time.

INSTANCE=example
KUMO_BIND_HOST=127.0.0.1
KUMO_API_PORT=8000
KUMO_UI_PORT=3000

# Broker: ibkr | alpaca. Paper only.
KUMO_BROKER=alpaca

# Every gate defaults closed. An instance boots disarmed; arm it after the book has been seen
# reconciling correctly.
KUMO_GATE_TRADING=false
KUMO_GATE_PROTECTION=false
