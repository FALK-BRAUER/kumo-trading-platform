# The COMPLETE secret set this instance is entitled to. ENV_VAR=secret-store-name. NOTHING ELSE.
# Values never appear in any file. The resolver unsets every known secret first, so a shell that
# exported another instance's keys cannot leak them into this deploy. An entry missing here is a
# refusal at deploy, not a fallback.
ALPACA_API_KEY=kumo-example-alpaca-key
ALPACA_API_SECRET=kumo-example-alpaca-secret
POSTGRES_PASSWORD=kumo-example-postgres
